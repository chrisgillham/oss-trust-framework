# OSS Trust Framework — Environment Variables
# Copy to .env and fill in your values. Never commit .env to version control.

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Notification Platform ────────────────────────────────────────────────────
# Set to: discord | teams | slack
QUORUM_PLATFORM=discord

# ── Discord (QUORUM_PLATFORM=discord) ────────────────────────────────────────
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_CHANNEL_ID=000000000000000000
DISCORD_GUILD_ID=000000000000000000

# ── MS Teams (QUORUM_PLATFORM=teams) ─────────────────────────────────────────
# Incoming webhook URL for the approval channel
TEAMS_WEBHOOK_URL=https://yourorg.webhook.office.com/webhookb2/...
# HTTPS endpoint that receives Action.Submit vote payloads (Azure Function etc.)
TEAMS_VOTE_WEBHOOK_URL=https://your-function.azurewebsites.net/api/quorum-vote
# Azure AD tenant ID (optional — for member resolution)
TEAMS_TENANT_ID=

# ── Slack (QUORUM_PLATFORM=slack) ─────────────────────────────────────────────
# Bot token with chat:write and users:read scopes
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C000000000
# Your Slack app's Interactivity Request URL
SLACK_VOTE_WEBHOOK_URL=https://your-endpoint.example.com/slack/actions
# Port for local vote callback server (Teams/Slack push voting)
VOTE_SERVER_PORT=3000

# ── Policy-as-code named role IDs (use platform-appropriate member IDs) ───────
CISO_DISCORD_ID=000000000000000000
SECURITY_ARCH_DISCORD_ID=000000000000000000
LEGAL_DISCORD_ID=000000000000000000

# ── Google Sheets Audit Log ───────────────────────────────────────────────────
# base64 -w0 service-account.json
SHEETS_CREDENTIALS=base64-encoded-service-account-json
SHEETS_SPREADSHEET_ID=your-spreadsheet-id-from-url
SHEETS_SHEET_NAME=QuorumAuditLog

# ── External security APIs ────────────────────────────────────────────────────
OSV_API_KEY=
SOCKET_API_KEY=
ENDOR_LABS_API_KEY=
ENDOR_LABS_PROJECT_UUID=
SNYK_TOKEN=
SNYK_ORG_ID=

# ── SIEM / Runtime Telemetry ──────────────────────────────────────────────────
# Splunk HEC endpoint — include full path:
# https://splunk.yourorg.com:8088/services/collector
SIEM_HEC_ENDPOINT=
SIEM_HEC_TOKEN=
# Webhook your SIEM calls when a runtime anomaly fires
ANOMALY_WEBHOOK_URL=
# Rollback webhook (if using custom adapter)
ROLLBACK_WEBHOOK_URL=

# ── Public Trust Registry (opt-in) ────────────────────────────────────────────
PUBLIC_REGISTRY_API_KEY=

# ── Reachability adapter ──────────────────────────────────────────────────────
# ENDOR_LABS_API_KEY and ENDOR_LABS_PROJECT_UUID set above
# or for Snyk:
# SNYK_TOKEN and SNYK_ORG_ID set above
